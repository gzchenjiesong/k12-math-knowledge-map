<view class="page tab-page">
  <view class="reading-back" wx:if="{{readingCanBack}}" bindtap="goReadingBack">‹ {{readingBackLabel}}</view>
  <view class="hero card">
    <view class="hero-top">
      <text class="h1">专题讲解</text>
      <view class="hero-progress">已掌握<text class="pct">{{stat.percent}}%</text></view>
    </view>
    <text class="lead">小学 · 初中 · 高中 · 奥赛</text>
    <view class="bar"><view class="bar-in" style="width:{{stat.percent}}%"></view></view>
    <view class="hero-stat">
      <text>共 {{stat.total}} 个知识点</text>
      <text>已掌握 {{stat.done}}</text>
      <text>学习中 {{stat.learning}}</text>
      <text>未开始 {{stat.todo}}</text>
    </view>
  </view>

  <view class="find-entry card" bindtap="goCards">
    <text class="find-title">查找知识点 ›</text>
  </view>

  <view class="section-title">{{lectures.length}} 个专题</view>
  <view class="lec-grid">
    <view class="lec card {{item.tone}}" wx:for="{{lectures}}" wx:key="id" bindtap="goLesson" data-id="{{item.id}}">
      <view class="lec-top">
        <text class="lec-name">{{item.title}}</text>
        <text class="lec-prog">已掌握 {{item.done}}/{{item.total}}</text>
      </view>
      <text class="lec-sub">{{item.subtitle}}</text>
      <view class="lec-bar"><view class="lec-bar-in" style="width:{{item.percent}}%"></view></view>
      <view class="lec-foot">
        <text wx:if="{{item.learning > 0}}" class="lec-tag learning">{{item.learning}} 个学习中</text>
        <text wx:if="{{item.done === item.total && item.total > 0}}" class="lec-tag done">全部已掌握</text>
        <text class="lec-enter">进入讲解 ›</text>
      </view>
    </view>
  </view>

</view>
