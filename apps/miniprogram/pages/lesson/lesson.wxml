<view class="page {{demo ? 'demo' : ''}}">
  <view class="reading-back" wx:if="{{readingCanBack}}" bindtap="goReadingBack">‹ {{readingBackLabel}}</view>
  <!-- 专题导语 -->
  <view class="intro card">
    <text class="i-title">{{group.title}}</text>
    <text class="i-sub">{{group.subtitle}}</text>
    <text class="i-lead">{{group.lead}}</text>
    <view class="goal"><text class="goal-tag">参考目标</text><text class="goal-text">{{group.goal}}</text></view>
    <view class="chain"><text class="chain-tag">知识链</text><text class="chain-text">{{group.chain}}</text></view>
    <view class="intro-bar"><view class="intro-bar-in" style="width:{{percent}}%"></view></view>
    <view class="intro-foot">
      <text class="intro-prog">已掌握 {{done}}/{{total}}</text>
      <view class="intro-actions">
        <text class="lnk lnk-cast" bindtap="goPresent">▣ 投屏演示</text>
        <text class="lnk" bindtap="expandAll">全部展开</text>
        <text class="lnk" bindtap="collapseAll">收起</text>
      </view>
    </view>

    <!-- 宽屏演示模式：一屏一个知识点，适合投影放大播放 -->
    <view class="demo-bar" wx:if="{{wide}}">
      <text class="demo-btn {{demo ? 'on' : ''}}" bindtap="toggleDemo">{{demo ? '退出演示' : '演示模式'}}</text>
      <block wx:if="{{demo}}">
        <text class="demo-nav" bindtap="demoPrev">‹ 上一个</text>
        <text class="demo-pos">{{focusIdx + 1}} / {{points.length}}</text>
        <text class="demo-nav" bindtap="demoNext">下一个 ›</text>
      </block>
    </view>
  </view>

  <!-- 知识点授课列表 -->
  <view class="pt card {{p.status===2?'ptdone':''}} {{demo && p.idx === focusIdx + 1 ? 'pt-focus' : ''}} {{demo && p.idx !== focusIdx + 1 ? 'pt-dim' : ''}}" wx:for="{{points}}" wx:key="nodeId" wx:for-item="p">
    <view class="pt-head" bindtap="togglePoint" data-id="{{p.nodeId}}">
      <view class="pt-idx">{{p.idx}}</view>
      <view class="pt-titlebox">
        <view class="pt-line">
          <text class="pt-title">{{p.title}}</text>
          <text class="src-tag src-{{p.domain}}">{{p.domainName}}</text>
        </view>
        <text class="pt-peek">{{p.essence}}</text>
      </view>
      <text class="pt-arrow {{openIds[p.nodeId]?'up':''}}">⌄</text>
    </view>

    <view class="pt-body" wx:if="{{openIds[p.nodeId]}}">
      <!-- 存疑操作独立于真源审核，来源详情按知识点展开。 -->
      <view class="source-actions">
        <view class="source-toggle" bindtap="togglePointSource" data-id="{{p.nodeId}}">
          <text>来源与审核</text><text>{{sourceOpenIds[p.nodeId] ? '▴' : '▾'}}</text>
        </view>
        <text class="ev-flag {{p.disputed?'on':''}}" bindtap="toggleDisputed" data-id="{{p.nodeId}}">{{p.disputed?'取消存疑':'标记存疑'}}</text>
      </view>
      <view class="evidence-bar ev-{{p.review}}" wx:if="{{sourceOpenIds[p.nodeId]}}">
        <view class="ev-line1">
          <text class="ev-badge evd-{{p.evidence}}">{{p.evidenceLabel}}</text>
          <text class="ev-review">真源审核 · {{p.reviewLabel}}</text>
        </view>
        <text class="ev-source">范围依据：{{p.sourceName}}</text>
        <text class="ev-note">{{p.wordingNote}}</text>
        <text class="lnk" bindtap="goNode" data-id="{{p.nodeId}}">卡片来源与缺口 ›</text>
      </view>

      <!-- 本质 -->
      <view class="sec">
        <view class="sec-h"><text class="sec-badge b1">1</text><text class="sec-t">知识本质</text></view>
        <text class="sec-text">{{p.essence}}</text>
      </view>

      <!-- 核心方法 -->
      <view class="sec">
        <view class="sec-h"><text class="sec-badge b2">2</text><text class="sec-t">核心方法与思维</text></view>
        <view class="method" wx:for="{{p.method}}" wx:key="*this" wx:for-item="m">
          <text class="method-dot">•</text><text class="method-t">{{m}}</text>
        </view>
      </view>

      <!-- 讲解型例题 -->
      <view class="sec" wx:if="{{p.example}}">
        <view class="sec-h"><text class="sec-badge b3">3</text><text class="sec-t">讲解型例题</text></view>
        <view class="ex-q">{{p.example.q}}</view>
        <view class="ex-toggle" bindtap="toggleExample" data-id="{{p.nodeId}}">
          <text>{{exampleFold[p.nodeId]?'收起解答 ▴':'查看解答 ▾'}}</text>
        </view>
        <view class="ex-a" wx:if="{{exampleFold[p.nodeId]}}">{{p.example.a}}</view>
      </view>

      <!-- 易错点 -->
      <view class="sec warn">
        <view class="sec-h"><text class="sec-badge b4">4</text><text class="sec-t">易错点</text></view>
        <view class="pit" wx:for="{{p.pitfalls}}" wx:key="*this" wx:for-item="pit">
          <text class="pit-x">✕</text><text class="pit-t">{{pit}}</text>
        </view>
      </view>

      <!-- 知识连接 -->
      <view class="sec link" wx:if="{{p.links}}">
        <view class="sec-h"><text class="sec-badge b5">5</text><text class="sec-t">知识连接</text></view>
        <text class="sec-text">{{p.links}}</text>
      </view>

      <!-- 概念自检 -->
      <view class="sec check">
        <view class="sec-h"><text class="sec-badge b6">6</text><text class="sec-t">概念自检</text></view>
        <view class="check-q" wx:for="{{p.check}}" wx:key="*this" wx:for-item="cq">{{cq}}</view>
      </view>

      <!-- 底部操作 -->
      <view class="pt-actions">
        <text class="status-pill s{{p.status}}" bindtap="chooseStatus" data-id="{{p.nodeId}}">{{p.statusName}} ▾</text>
        <view class="pt-links">
          <text class="lnk" bindtap="goNode" data-id="{{p.nodeId}}">看卡片详情 ›</text>
        </view>
      </view>
      <view class="pt-topics" wx:if="{{p.topics.length > 0}}">
        <text class="pt-topics-label">相关题型</text>
        <text class="topic-chip" wx:for="{{p.topics}}" wx:key="id" wx:for-item="tp" bindtap="goTopic" data-id="{{tp.id}}">{{tp.title}}</text>
      </view>
    </view>
  </view>

  <button class="finish-btn" bindtap="markWholeDone" wx:if="{{done < total && total > 0}}">全部标为已掌握</button>
</view>
