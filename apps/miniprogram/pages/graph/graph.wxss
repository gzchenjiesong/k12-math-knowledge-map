.reading-back { display: flex; align-items: center; box-sizing: border-box; min-height: 44px; margin-bottom: 10px; padding: 8px 12px; border-radius: 8px; background: #fff; color: #1f6feb; font-size: 13px; line-height: 1.5; }
.head { padding: 16px; }
.head-top { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; }
.h1 { font-size: 22px; font-weight: 700; color: #1f2d3d; }
.pct { font-size: 24px; font-weight: 700; color: #1f6feb; }
.sub { display: block; margin-top: 5px; font-size: 13px; color: #637086; }
.bar { height: 6px; background: #eef1f6; border-radius: 5px; margin-top: 12px; overflow: hidden; }
.bar-in { height: 100%; background: linear-gradient(90deg, #1f6feb, #4aa3ff); border-radius: 5px; }
.stat-row { display: flex; margin-top: 13px; }
.stat-item { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 20px; font-weight: 700; }
.stat-num.green { color: #1a8a4a; }
.stat-num.orange { color: #b96a10; }
.stat-num.gray { color: #6b7688; }
.stat-label { font-size: 13px; color: #637086; margin-top: 2px; }
.tip { padding: 2px 6px 10px; font-size: 13px; color: #637086; }

.domain { min-width: 0; margin-bottom: 12px; }
.domain-head { box-sizing: border-box; min-height: 44px; padding: 12px 14px; border-radius: 9px 9px 0 0; color: #fff; }
.domain-head.primary { background: linear-gradient(135deg, #6f52c9, #9b7de0); }
.domain-head.junior { background: linear-gradient(135deg, #2f7de0, #4a9bf5); }
.domain-head.senior { background: linear-gradient(135deg, #19967a, #2bb894); }
.domain-head.olympiad { background: linear-gradient(135deg, #c8671c, #e08b3c); }
.domain-title { display: flex; align-items: center; font-size: 18px; font-weight: 700; }
.domain-title text { min-width: 0; }
.arrow { width: 16px; flex-shrink: 0; font-size: 16px; }
.domain-sub { display: block; margin-top: 4px; margin-left: 16px; font-size: 13px; }

.module { background: #fff; border-radius: 0 0 8px 8px; margin: 0 0 8px; }
.module-head { display: flex; align-items: center; box-sizing: border-box; min-height: 44px; padding: 11px 14px; border-bottom: 1px solid #f0f2f6; }
.module-arrow { width: 15px; flex-shrink: 0; color: #1f6feb; font-size: 16px; }
.module-name { flex: 1; min-width: 0; font-size: inherit; font-weight: 600; color: #33405a; }
.module-count { flex-shrink: 0; margin-left: 6px; font-size: 13px; color: #637086; background: #f2f5f9; padding: 2px 7px; border-radius: 10px; }

/* 正文保有独立行宽，状态命中区放不下时换行，不挤成竖排。 */
.topic { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; box-sizing: border-box; min-height: 44px; padding: 10px 30px 10px 14px; border-bottom: 1px solid #f5f6f8; }
.topic:last-child { border-bottom: none; }
.dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
.dot.s0 { background: #b3bdcb; }
.dot.s1 { background: #f0a93b; }
.dot.s2 { background: #2bb573; }
.topic-body { flex: 1 1 156px; min-width: 0; }
.topic-line { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; }
.topic-name { min-width: 0; max-width: 100%; font-size: inherit; color: #1f2329; font-weight: 500; }
.card-badge { font-size: 13px; color: #1f6feb; background: #e9f1ff; padding: 1px 6px; border-radius: 8px; }
.topic-desc { display: block; margin-top: 3px; font-size: 13px; color: #637086; white-space: normal; }
.status-control { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 44px; max-width: 100%; margin-left: auto; padding: 8px 10px; font-size: 13px; line-height: 1.5; text-align: center; border-radius: 8px; white-space: normal; }
.status-control.s0 { background: #eef2f8; color: #526075; }
.status-control.s1 { background: #fff1e0; color: #99560c; }
.status-control.s2 { background: #e6f6ec; color: #1a8a4a; }
.chevron { position: absolute; top: 12px; right: 10px; font-size: 20px; color: #7a8699; }

.seg { display: flex; margin: 2px 0 10px; background: #e9edf4; border-radius: 7px; padding: 3px; }
.seg-i { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 44px; text-align: center; padding: 8px 6px; font-size: inherit; color: #637086; border-radius: 5px; }
.seg-i.on { background: #fff; color: #1f6feb; font-weight: 700; box-shadow: 0 1px 4px rgba(31,45,61,.08); }

.theme { min-width: 0; margin-bottom: 12px; border-radius: 8px; overflow: hidden; background: #fff; box-shadow: 0 1px 5px rgba(31,45,61,.05); }
.theme-head { box-sizing: border-box; min-height: 44px; padding: 11px 14px 10px; background: #2c3e50; }
.theme-head.tone1  { border-left: 5px solid #4a9bf5; }
.theme-head.tone2  { border-left: 5px solid #f0a93b; }
.theme-head.tone3  { border-left: 5px solid #5ac8b0; }
.theme-head.tone4  { border-left: 5px solid #9b7de0; }
.theme-head.tone5  { border-left: 5px solid #e8738c; }
.theme-head.tone6  { border-left: 5px solid #4b8ef0; }
.theme-head.tone7  { border-left: 5px solid #69a8d8; }
.theme-head.tone8  { border-left: 5px solid #d0914c; }
.theme-head.tone9  { border-left: 5px solid #c96fbe; }
.theme-head.tone10 { border-left: 5px solid #62b57a; }
.theme-head.tone11 { border-left: 5px solid #9b7de0; }
.theme-line { display: flex; align-items: center; gap: 6px; }
.theme-line .arrow { color: #fff; }
.theme-name { flex: 1; min-width: 0; font-size: 18px; font-weight: 700; color: #fff; }
.theme-prog { flex-shrink: 0; font-size: 13px; color: #d4deea; background: rgba(255,255,255,.12); padding: 2px 8px; border-radius: 10px; }
.theme-sub { display: block; margin: 4px 0 7px 22px; font-size: 13px; color: #d4deea; }
.theme-bar { height: 4px; margin-left: 22px; background: rgba(255,255,255,.16); border-radius: 4px; overflow: hidden; }
.theme-bar-in { height: 100%; background: #6fd3a0; border-radius: 4px; }
.theme-body { padding-bottom: 2px; }

.src-tag { max-width: 100%; padding: 1px 6px; border-radius: 7px; font-size: 13px; }
.src-primary { color: #6f52c9; background: #f1ecff; }
.src-junior { color: #2f7de0; background: #e9f1ff; }
.src-senior { color: #167b65; background: #e5f6f1; }
.src-olympiad { color: #a95214; background: #fdf0e4; }
.bridge-badge { padding: 1px 5px; border-radius: 7px; font-size: 13px; color: #985009; background: #fef3c7; }

.bridge-card { margin-bottom: 12px; border-radius: 8px; overflow: hidden; background: #fff; box-shadow: 0 1px 5px rgba(31,45,61,.05); }
.bridge-head { position: relative; box-sizing: border-box; min-height: 44px; padding: 12px 14px; background: linear-gradient(135deg, #0f766e, #119b8d); color: #fff; }
.bridge-headline { display: flex; align-items: center; gap: 6px; }
.bridge-icon { font-size: 20px; flex-shrink: 0; }
.bridge-title { font-size: 18px; font-weight: 700; flex: 1; min-width: 0; }
.bridge-count { flex-shrink: 0; font-size: 13px; background: rgba(255,255,255,.18); padding: 2px 8px; border-radius: 10px; }
.bridge-sub { display: block; margin: 4px 20px 0 26px; font-size: 13px; }
.bridge-arrow { flex-shrink: 0; margin-left: 4px; font-size: 16px; }
.bridge-body { padding: 4px 10px 10px; }
.bridge-kind { margin-top: 9px; }
.bridge-kind-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 8px; padding: 0 4px 5px; border-bottom: 1px solid #f0f2f6; }
.bridge-kind-name { font-size: inherit; font-weight: 600; color: #33405a; }
.bridge-kind-count { font-size: 13px; color: #637086; }
.bridge-row { display: flex; align-items: center; padding: 7px 4px; border-bottom: 1px solid #f5f6f8; }
.bridge-row:last-child { border-bottom: none; }
.bridge-node { flex: 1; min-width: 0; min-height: 44px; display: flex; flex-direction: column; justify-content: center; }
.bridge-node-domain { font-size: 13px; color: #2f7de0; }
.bridge-node-domain.p { color: #6f52c9; }
.bridge-node-name { font-size: inherit; color: #1f2329; margin-top: 2px; white-space: normal; }
.bridge-arrow-mid { width: 28px; text-align: center; font-size: 18px; color: #0f766e; flex-shrink: 0; }
.bridge-foot { margin-top: 8px; padding: 6px 8px; font-size: 13px; color: #637086; background: #f7f9fc; border-radius: 5px; }

@media (min-width: 768px) {
  .list-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: start; }
  .head { padding: 22px 26px; }
  .h1 { font-size: 26px; }
  .pct { font-size: 28px; }
  .stat-num { font-size: 22px; }
  .domain-head, .theme-head, .bridge-head { padding: 16px 18px; }
  .module-head { padding: 12px 18px; }
  .topic { padding: 12px 34px 12px 18px; }
}
