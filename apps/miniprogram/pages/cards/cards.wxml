<view class="page">
  <view class="searchbox">
    <text class="search-icon">⌕</text>
    <input class="search-input" placeholder="搜索知识点、定理、方法…" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
  </view>

  <view class="filters">
    <view class="filter {{filter === 'all' ? 'active' : ''}}" bindtap="setFilter" data-filter="all">全部教程</view>
    <view class="filter {{filter === 'unmastered' ? 'active' : ''}}" bindtap="setFilter" data-filter="unmastered">未掌握</view>
    <text class="count">共 {{count}} 个知识点</text>
  </view>

  <view class="tip">已编写 {{count}} 个知识点的三维卡片，内容持续分批补充中</view>

  <view class="card-list">
    <view class="card item" wx:for="{{list}}" wx:key="id" bindtap="goNode" data-id="{{item.id}}">
      <view class="item-head">
        <text class="item-name">{{item.n}}</text>
        <text class="status-dot s{{item.status}}"></text>
      </view>
      <text class="item-domain">{{item.domainName}} · {{item.module}}</text>
      <text class="item-concept">{{item.conceptTitle}}</text>
      <view class="item-badges">
        <text class="mini-tag blue">知识点</text>
        <text class="mini-tag green">讲解 {{item.explainCount}}</text>
        <text class="mini-tag orange">例题 {{item.exampleCount}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{count === 0}}">没有匹配的卡片，换个关键词试试</view>
</view>
