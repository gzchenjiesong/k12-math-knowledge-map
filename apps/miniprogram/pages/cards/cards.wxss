.reading-back { display: flex; align-items: center; box-sizing: border-box; min-height: 44px; margin-bottom: 10px; padding: 8px 12px; border-radius: 8px; background: #fff; color: #1f6feb; font-size: 13px; line-height: 1.5; }
.searchbox { display: flex; align-items: center; box-sizing: border-box; min-height: 48px; background: #fff; border-radius: 8px; padding: 0 12px; margin-bottom: 12px; }
.search-icon { flex-shrink: 0; font-size: 22px; color: #6b7688; margin-right: 7px; }
.search-input { flex: 1; min-width: 0; min-height: 44px; font-size: inherit; color: #1f2329; }

.filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 8px; }
.filter { display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 44px; padding: 8px 13px; font-size: inherit; color: #637086; background: #fff; border-radius: 14px; }
.filter.active { background: #1f6feb; color: #fff; }
.count { margin-left: auto; font-size: 13px; color: #637086; }
.tip { font-size: 13px; color: #637086; padding: 0 3px 10px; }

.item { min-height: 44px; padding: 14px; }
.item-head { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; }
.item-name { flex: 1 1 120px; min-width: 0; font-size: 18px; font-weight: 700; color: #1f2d3d; }
.status-indicator { display: inline-flex; align-items: center; gap: 6px; max-width: 100%; }
.status-dot { display: inline-block; flex-shrink: 0; width: 8px; height: 8px; border-radius: 50%; }
.status-dot.s0 { background: #b3bdcb; }
.status-dot.s1 { background: #f0a93b; }
.status-dot.s2 { background: #2bb573; }
.status-label { font-size: 13px; line-height: 1.5; color: #637086; white-space: nowrap; }
.item-domain { display: block; margin-top: 4px; font-size: 13px; color: #637086; }
.item-concept { display: block; margin-top: 6px; font-size: inherit; color: #526075; line-height: 1.65; }
.item-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.mini-tag { display: inline-block; max-width: 100%; font-size: 13px; padding: 3px 7px; border-radius: 9px; }
.mini-tag.blue { background: #e9f1ff; color: #1f6feb; }
.mini-tag.green { background: #e8f7ee; color: #1a8a4a; }
.mini-tag.orange { background: #fff2e3; color: #99560c; }

@media (min-width: 768px) {
  .card-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; align-items: start; }
  .card-list .item { margin-bottom: 0; }
  .searchbox { min-height: 52px; padding: 0 16px; }
  .filter { padding: 8px 16px; }
  .item { padding: 16px 18px; }
}
