.searchbox { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 0 24rpx; height: 84rpx; margin-bottom: 20rpx; }
.search-icon { font-size: 38rpx; color: #a8b0bd; margin-right: 14rpx; }
.search-input { flex: 1; font-size: 28rpx; color: #1f2329; }

.filters { display: flex; align-items: center; margin-bottom: 16rpx; }
.filter { padding: 12rpx 26rpx; font-size: 25rpx; color: #7a8699; background: #fff; border-radius: 24rpx; margin-right: 14rpx; }
.filter.active { background: #1f6feb; color: #fff; }
.count { margin-left: auto; font-size: 22rpx; color: #9aa4b4; }
.tip { font-size: 22rpx; color: #9aa4b4; padding: 0 6rpx 20rpx; }

.item { padding: 26rpx 28rpx; }
.item-head { display: flex; align-items: center; justify-content: space-between; }
.item-name { font-size: 30rpx; font-weight: 700; color: #1f2d3d; }
.status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.status-dot.s0 { background: #d8dee8; }
.status-dot.s1 { background: #f0a93b; }
.status-dot.s2 { background: #2bb573; }
.item-domain { display: block; margin-top: 8rpx; font-size: 22rpx; color: #9aa4b4; }
.item-concept { display: block; margin-top: 12rpx; font-size: 26rpx; color: #5a6678; line-height: 1.5; }
.item-badges { margin-top: 16rpx; }
.mini-tag { display: inline-block; font-size: 21rpx; padding: 5rpx 14rpx; border-radius: 18rpx; margin-right: 12rpx; }
.mini-tag.blue { background: #e9f1ff; color: #1f6feb; }
.mini-tag.green { background: #e8f7ee; color: #1a8a4a; }
.mini-tag.orange { background: #fff2e3; color: #c77a1e; }

/* 宽屏：卡片三列网格，字号回到物理尺寸 */
@media (min-width: 768px) {
  .card-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; align-items: start; }
  .searchbox { height: 52px; padding: 0 16px; }
  .search-icon { font-size: 22px; }
  .search-input, .item-name { font-size: 16px; }
  .filter { font-size: 14px; padding: 8px 16px; }
  .count, .tip, .item-domain, .mini-tag { font-size: 12px; }
  .item-concept { font-size: 15px; }
  .item { padding: 16px 18px; }
}
