/* 投屏演示页：深色高对比大字，投到电视后远距离可读。手机端体验次要。 */
.stage {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #0b1020;
  color: #f4f6fb;
  overflow: hidden;
}

/* 顶部信息条 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 32rpx 6rpx;
  flex-shrink: 0;
}
.top-title { display: flex; align-items: center; flex: 1; min-width: 0; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #4fd1a5; margin-right: 14rpx; flex-shrink: 0; }
.brand { font-size: 26rpx; color: #8fa3c8; font-weight: 600; letter-spacing: 2rpx; }
.sep { font-size: 24rpx; color: #5a6b8c; margin: 0 12rpx; }
.gname { font-size: 28rpx; color: #cfd9ec; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.top-right { display: flex; align-items: center; flex-shrink: 0; }
.progress { font-size: 30rpx; color: #f0c561; font-weight: 700; font-variant-numeric: tabular-nums; margin-right: 24rpx; }
.quit { font-size: 24rpx; color: #8697b6; padding: 8rpx 16rpx; border: 1rpx solid #33405e; border-radius: 24rpx; }

/* 进度条 */
.bar-track { height: 6rpx; background: #1c2740; margin: 0 32rpx 8rpx; border-radius: 3rpx; flex-shrink: 0; }
.bar-fill { height: 100%; background: linear-gradient(90deg, #4fd1a5, #f0c561); border-radius: 3rpx; transition: width .2s ease; }

/* 幻灯片画布 */
/* 关键：flex 子项必须 min-height:0，否则 scroll-view 按内容撑开会顶出底部按钮栏 */
.canvas { flex: 1; min-height: 0; width: 100%; }
.slide {
  box-sizing: border-box;
  min-height: 100%;
  padding: 40rpx 64rpx 80rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
/* 宽屏（横屏 iPad / 手机横屏镜像）限制阅读宽度，避免一行太长 */
@media (min-width: 768px) {
  .slide { padding: 48rpx 10vw 64rpx; }
  .body, .btext { max-width: 1600rpx; }
}

.eyebrow { font-size: 30rpx; color: #4fd1a5; letter-spacing: 3rpx; margin-bottom: 28rpx; font-weight: 600; }
.title { font-size: 72rpx; font-weight: 800; line-height: 1.3; color: #ffffff; margin-bottom: 36rpx; word-break: break-all; }
.sub { font-size: 40rpx; color: #9db0d4; line-height: 1.5; margin-top: -20rpx; margin-bottom: 32rpx; }

.body { font-size: 38rpx; line-height: 1.65; color: #e6ecf8; font-weight: 400; }
.body.answer { color: #d9f5e8; border-left: 8rpx solid #4fd1a5; padding-left: 32rpx; }

.bullets { margin-top: 16rpx; }
.bullet { display: flex; align-items: flex-start; margin-bottom: 26rpx; }
.bidx {
  width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center;
  border-radius: 50%; background: #22315a; color: #f0c561;
  font-size: 28rpx; font-weight: 700; margin-right: 24rpx; flex-shrink: 0;
}
.btext { flex: 1; font-size: 36rpx; line-height: 1.55; color: #e6ecf8; }

/* 封面 / 结束页：居中隆重，但控制在一屏内（iPad 竖屏 1184px 实测） */
.slide-cover .title, .slide-end .title {
  font-size: 60rpx; text-align: center; margin-top: 12rpx; margin-bottom: 28rpx;
  word-break: break-all; line-height: 1.35;
}
.slide-cover .eyebrow, .slide-end .eyebrow { text-align: center; }
.slide-cover .body, .slide-end .body {
  text-align: center; font-size: 34rpx; color: #b9c8e6; line-height: 1.6;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5; overflow: hidden;
}
.slide-cover .bullets, .slide-end .bullets { justify-content: center; }
/* 封面 bullets 也限高，避免目标文字被底部按钮栏压住 */
.slide-cover .bullet .btext, .slide-end .bullet .btext {
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; font-size: 32rpx;
}
.slide-cover .sub { text-align: center; font-size: 30rpx; line-height: 1.4; }

/* 易错自检页用暖色强调 */
.slide-recap .bidx { background: #5a3a1c; color: #f5b865; }
.slide-recap .eyebrow { color: #f5b865; }

/* 例题页提示 */
.hint { margin-top: 40rpx; font-size: 28rpx; color: #7f93b8; font-style: italic; }

/* 底部遥控器：大按钮，横屏竖屏都好点 */
.controls {
  display: flex; gap: 20rpx; padding: 18rpx 32rpx 24rpx;
  background: #080d18; border-top: 1rpx solid #1c2740; flex-shrink: 0;
}
.ctl {
  padding: 24rpx 0; border-radius: 20rpx; text-align: center;
  font-size: 36rpx; font-weight: 700; letter-spacing: 2rpx;
}
.ctl-toc { flex: 0 0 20%; background: #1b2540; color: #c7d4ec; }
.ctl-prev { flex: 1; background: #22315a; color: #e6ecf8; }
.ctl-next { flex: 1; background: #4fd1a5; color: #06251b; }
.ctl.disabled { opacity: .35; }

/* ===== 矮横屏（手机横屏镜像到电视的常见形态，如 874×276）=====
   顶部条 + 按钮栏在矮屏会吃掉大半高度，必须整体压缩，把空间还给内容区。
   命中条件：宽屏且高度 <= 560px；iPad 竖屏(1032×1376)、大屏横屏(高度>560)不受影响。 */
@media (min-width: 768px) and (max-height: 560px) {
  .topbar { padding: 4rpx 24rpx 2rpx; }
  .brand { font-size: 20rpx; }
  .sep { font-size: 18rpx; margin: 0 8rpx; }
  .gname { font-size: 22rpx; }
  .progress { font-size: 24rpx; margin-right: 14rpx; }
  .quit { font-size: 20rpx; padding: 4rpx 12rpx; }
  .bar-track { height: 4rpx; margin: 0 24rpx 4rpx; }

  .slide { padding: 12rpx 40rpx 20rpx; }
  .eyebrow { font-size: 20rpx; margin-bottom: 8rpx; letter-spacing: 2rpx; }
  .title { font-size: 42rpx; margin-bottom: 12rpx; line-height: 1.25; }
  .sub { font-size: 24rpx; margin-top: -8rpx; margin-bottom: 10rpx; }
  .body { font-size: 26rpx; line-height: 1.45; }
  .body.answer { border-left-width: 5rpx; padding-left: 20rpx; }
  .bullets { margin-top: 6rpx; }
  .bullet { margin-bottom: 8rpx; }
  .bidx { width: 34rpx; height: 34rpx; line-height: 34rpx; font-size: 18rpx; margin-right: 14rpx; }
  .btext { font-size: 24rpx; line-height: 1.4; }
  .hint { margin-top: 12rpx; font-size: 20rpx; }

  /* 封面/结束页在矮屏更激进地限行，确保标题与正文都完整可见 */
  .slide-cover .title, .slide-end .title {
    font-size: 40rpx; margin-top: 4rpx; margin-bottom: 10rpx;
  }
  .slide-cover .body, .slide-end .body {
    font-size: 22rpx; line-height: 1.4; -webkit-line-clamp: 2;
  }
  /* 矮屏封面/结束页直接隐藏 bullets（本节目标等内容翻页可见），彻底避免被按钮栏压住 */
  .slide-cover .bullets, .slide-end .bullets { display: none; }
  .slide-cover .sub { font-size: 20rpx; }

  /* 按钮栏瘦身：从约 126rpx 压到约 60rpx */
  .controls { gap: 12rpx; padding: 8rpx 24rpx 12rpx; }
  .ctl { padding: 12rpx 0; font-size: 26rpx; border-radius: 14rpx; }
}

/* 目录浮层 */
.toc-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; background: rgba(4, 8, 18, .88); z-index: 20; display: flex; align-items: center; justify-content: center; }
.toc-panel { width: 86%; max-width: 900rpx; max-height: 76%; background: #101a30; border: 2rpx solid #2b3a5c; border-radius: 24rpx; display: flex; flex-direction: column; overflow: hidden; }
.toc-head { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 36rpx; border-bottom: 1rpx solid #263554; }
.toc-title { font-size: 40rpx; font-weight: 700; color: #fff; }
.toc-close { font-size: 28rpx; color: #8fa3c8; }
.toc-list { max-height: 60vh; padding: 12rpx 0; }
.toc-item { display: flex; align-items: center; padding: 22rpx 36rpx; border-bottom: 1rpx solid #1c2740; }
.toc-item.active { background: #1b2a4a; }
.toc-label { font-size: 26rpx; color: #f0c561; width: 180rpx; flex-shrink: 0; }
.toc-name { font-size: 36rpx; color: #e6ecf8; }
