<!-- 投屏演示页：16:9 固定画布等比缩放，居中 letterbox；手机/iPad 横屏当遥控器 -->
<view class="stage" style="padding-top:{{statusBarH}}px;" bindtouchstart="touchStart" bindtouchend="touchEnd">

  <!-- 16:9 幻灯片画布：外层按设备算出的 px 定尺，内层固定 1280×720 坐标系等比缩放 -->
  <view class="canvas-wrap">
    <view class="deck-frame" style="width:{{canvasW}}px;height:{{canvasH}}px;">
      <view class="deck" style="width:1280px;height:720px;transform:scale({{deckScale}});">

        <!-- 顶部：专题名 + 进度（在画布内，电视上可见） -->
        <view class="deck-head">
          <view class="dh-left">
            <text class="dh-dot"></text>
            <text class="dh-brand">数海扶摇</text>
            <text class="dh-sep">/</text>
            <text class="dh-group">{{groupTitle}}</text>
          </view>
          <text class="dh-page">{{cur + 1}} / {{total}}</text>
        </view>
        <view class="deck-track"><view class="deck-fill" style="width:{{(cur + 1) * 100 / total}}%;"></view></view>

        <!-- 幻灯片正文：按类型排版 -->
        <view class="slide-body">

          <!-- 封面 / 结束：居中隆重 -->
          <view wx:if="{{slide.kind === 'cover' || slide.kind === 'end'}}" class="ly-center">
            <text class="c-eyebrow">{{slide.eyebrow}}</text>
            <text class="c-title">{{slide.title}}</text>
            <text wx:if="{{slide.sub}}" class="c-sub">{{slide.sub}}</text>
            <view wx:if="{{slide.body}}" class="c-lead">{{slide.body}}</view>
            <view wx:if="{{slide.bullets.length}}" class="c-chips">
              <view class="chip" wx:for="{{slide.bullets}}" wx:key="*this">{{item}}</view>
            </view>
          </view>

          <!-- 知识本质：大字金句式 -->
          <view wx:elif="{{slide.kind === 'essence'}}" class="ly-essence">
            <text class="e-kicker">{{slide.eyebrow}}</text>
            <text class="e-title">{{slide.title}}</text>
            <view class="e-quote">
              <text class="e-mark">“</text>
              <text class="e-text">{{slide.body}}</text>
            </view>
          </view>

          <!-- 方法要点：编号卡片 -->
          <view wx:elif="{{slide.kind === 'method'}}" class="ly-method">
            <text class="m-kicker">{{slide.eyebrow}}</text>
            <text class="m-title">{{slide.title}}</text>
            <view class="m-list">
              <view class="m-row" wx:for="{{slide.bullets}}" wx:key="*this">
                <text class="m-num">{{index + 1}}</text>
                <text class="m-text">{{item}}</text>
              </view>
            </view>
          </view>

          <!-- 例题·先看题：题干居中 + 提示先思后答 -->
          <view wx:elif="{{slide.kind === 'question'}}" class="ly-question">
            <text class="q-kicker">{{slide.eyebrow}}</text>
            <text class="q-title">{{slide.title}}</text>
            <view class="q-paper"><text class="q-text">{{slide.body}}</text></view>
            <text class="q-hint">先独立思考，再翻页看解析 →</text>
          </view>

          <!-- 例题·解析：绿框突出结论 -->
          <view wx:elif="{{slide.kind === 'answer'}}" class="ly-answer">
            <text class="a-kicker">{{slide.eyebrow}}</text>
            <text class="a-q">题目回顾：{{slide.qtext}}</text>
            <view class="a-paper"><text class="a-text">{{slide.body}}</text></view>
          </view>

          <!-- 易错与自检：左右双栏 -->
          <view wx:elif="{{slide.kind === 'recap'}}" class="ly-recap">
            <text class="r-kicker">{{slide.eyebrow}}</text>
            <text class="r-title">{{slide.title}}</text>
            <view class="r-cols">
              <view wx:if="{{slide.pitfalls.length}}" class="r-col r-warn">
                <text class="r-col-head">易错警示</text>
                <view class="r-row" wx:for="{{slide.pitfalls}}" wx:key="*this">
                  <text class="r-bullet">!</text>
                  <text class="r-text">{{item}}</text>
                </view>
              </view>
              <view wx:if="{{slide.checks.length}}" class="r-col r-check">
                <text class="r-col-head">概念自检</text>
                <view class="r-row" wx:for="{{slide.checks}}" wx:key="*this">
                  <text class="r-bullet">?</text>
                  <text class="r-text">{{item}}</text>
                </view>
              </view>
            </view>
          </view>

        </view>

        <!-- 画布内页脚 -->
        <view class="deck-foot">
          <text class="df-brand">数海扶摇 · 知识图谱</text>
          <text class="df-kind">{{slide.title}}</text>
        </view>

      </view>
    </view>
  </view>

  <!-- 遥控器：大按钮悬浮在画布底部外，自动淡出；触摸任意处唤醒 -->
  <view class="controls {{controlsHidden ? 'hidden' : ''}}" style="padding-bottom:{{safeBottom}}px;">
    <view class="ctl ctl-toc" bindtap="toggleToc">目录</view>
    <view class="ctl ctl-prev {{cur === 0 ? 'disabled' : ''}}" bindtap="prev">← 上一页</view>
    <view class="ctl ctl-next {{cur === total - 1 ? 'disabled' : ''}}" bindtap="next">下一页 →</view>
    <view class="ctl ctl-quit" bindtap="quit">退出 ✕</view>
  </view>

  <!-- 目录浮层：演示中跳到某个知识点 -->
  <view wx:if="{{tocOpen}}" class="toc-mask" bindtap="toggleToc">
    <view class="toc-panel" catchtap="noop">
      <view class="toc-head">
        <text class="toc-title">知识点目录</text>
        <text class="toc-close" bindtap="toggleToc">收起 ✕</text>
      </view>
      <scroll-view class="toc-list" scroll-y="true">
        <view class="toc-item {{pointStarts[index] === cur ? 'active' : ''}}" wx:for="{{toc}}" wx:key="nodeId" data-start="{{item.start}}" bindtap="jumpToc">
          <text class="toc-label">{{item.label}}</text>
          <text class="toc-name">{{item.title}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

</view>
