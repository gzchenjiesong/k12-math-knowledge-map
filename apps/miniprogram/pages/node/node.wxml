<view class="page" wx:if="{{node}}">
  <!-- 知识点头部 -->
  <view class="card head">
    <view class="head-row">
      <view class="label-group">
        <text class="domain-label">{{node.domainName}}</text>
        <text wx:if="{{themeName}}" class="theme-label" bindtap="goTheme">{{themeName}} ›</text>
      </view>
      <text class="status-pill s{{status}}" bindtap="cycleStatus">{{statusName}} · 点按切换</text>
    </view>
    <text class="title">{{node.n}}</text>
    <text class="oneline">{{node.d}}</text>
    <text class="module-label">{{node.module}}</text>
  </view>

  <!-- 三维卡片切换 -->
  <view class="tabs">
    <view class="tab {{tab === 'concept' ? 'active' : ''}}" bindtap="switchTab" data-tab="concept">知识点</view>
    <view class="tab {{tab === 'explain' ? 'active' : ''}}" bindtap="switchTab" data-tab="explain">知识讲解</view>
    <view class="tab {{tab === 'example' ? 'active' : ''}}" bindtap="switchTab" data-tab="example">试题示例</view>
  </view>

  <!-- 知识点 -->
  <view wx:if="{{tab === 'concept'}}">
    <view class="card" wx:if="{{card && card.concept}}">
      <text class="card-title">{{card.concept.title}}</text>
      <text class="body-text">{{card.concept.body}}</text>
      <view class="points">
        <view class="point" wx:for="{{card.concept.points}}" wx:key="*this">
          <text class="bullet">•</text><text class="point-text">{{item}}</text>
        </view>
      </view>
    </view>
    <view class="card empty-card" wx:else>
      <text class="empty-title">知识点卡片待补充</text>
      <text class="empty-desc">该知识点暂未编写讲解内容，可先参考下方「关联知识」或在笔记中记录。</text>
    </view>

    <!-- 关键子点（来自图谱数据，始终可见） -->
    <view class="card">
      <text class="card-title">关键子点</text>
      <view class="chips">
        <text class="tag" wx:for="{{node.p}}" wx:key="*this">{{item}}</text>
      </view>
      <view wx:if="{{node.sig.length > 0}}">
        <text class="card-title second">题目识别信号</text>
        <view class="chips">
          <text class="tag tag-orange" wx:for="{{node.sig}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <view wx:if="{{node.ap.length > 0}}">
        <text class="card-title second">解题切入方向</text>
        <view class="ap-line" wx:for="{{node.ap}}" wx:key="*this">→ {{item}}</view>
      </view>
    </view>
  </view>

  <!-- 知识讲解 -->
  <view wx:if="{{tab === 'explain'}}">
    <view class="card" wx:for="{{card.explain}}" wx:for-item="ex" wx:key="title">
      <text class="card-title">{{ex.title}}</text>
      <text class="body-text">{{ex.body}}</text>
      <view class="points">
        <view class="point" wx:for="{{ex.points}}" wx:key="*this">
          <text class="bullet">•</text><text class="point-text">{{item}}</text>
        </view>
      </view>
    </view>
    <view class="card empty-card" wx:if="{{!card || !card.explain || card.explain.length === 0}}">
      <text class="empty-title">讲解卡片待补充</text>
      <text class="empty-desc">后续会按知识点分批填充讲解内容。</text>
    </view>
  </view>

  <!-- 试题示例 -->
  <view wx:if="{{tab === 'example'}}">
    <view class="card ex-card" wx:for="{{card.examples}}" wx:for-item="ex" wx:key="title">
      <view class="ex-head">
        <text class="card-title">{{ex.title}}</text>
        <text class="level">{{ex.level}}</text>
      </view>
      <view class="question">{{ex.question}}</view>
      <view class="fold" bindtap="toggleFold" data-idx="{{index}}">
        <text>{{foldState[index] ? '收起提示与解答 ▴' : '查看提示与解答 ▾'}}</text>
      </view>
      <view wx:if="{{foldState[index]}}">
        <view class="solution-block">
          <text class="block-label">思路提示</text>
          <text class="block-text">{{ex.hint}}</text>
        </view>
        <view class="solution-block">
          <text class="block-label">解答</text>
          <text class="block-text">{{ex.solution}}</text>
        </view>
        <view class="answer">答案：{{ex.answer}}</view>
      </view>
    </view>
    <view class="card empty-card" wx:if="{{!card || !card.examples || card.examples.length === 0}}">
      <text class="empty-title">试题卡片待补充</text>
      <text class="empty-desc">后续会按知识点分批填充例题。</text>
    </view>
  </view>

  <!-- 关系网络 -->
  <view class="card" wx:if="{{preNodes.length > 0 || relNodes.length > 0}}">
    <text class="card-title">知识关联</text>
    <view wx:if="{{preNodes.length > 0}}">
      <text class="rel-label">前置依赖</text>
      <view class="chips">
        <text class="tag tag-blue" wx:for="{{preNodes}}" wx:key="id" bindtap="goNode" data-id="{{item.id}}">{{item.n}} ›</text>
      </view>
    </view>
    <view wx:if="{{relNodes.length > 0}}">
      <text class="rel-label">关联知识</text>
      <view class="chips">
        <text class="tag tag-purple" wx:for="{{relNodes}}" wx:key="id" bindtap="goNode" data-id="{{item.id}}">{{item.n}} ›</text>
      </view>
    </view>
  </view>

  <!-- 常考题型（题型↔知识点双向索引） -->
  <view class="card" wx:if="{{topicList.length > 0}}">
    <text class="card-title">常考题型 · 点按看讲解</text>
    <text class="rel-hint">这个知识点在不同讲次里常以这些题型出现</text>
    <view class="topic-links">
      <view class="topic-link" wx:for="{{topicList}}" wx:key="id" bindtap="goTopic" data-id="{{item.id}}">
        <text class="topic-link-name">{{item.name}}</text>
        <text class="topic-link-theme">{{item.themeName}}</text>
        <text class="topic-link-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 我的笔记 -->
  <view class="card">
    <view class="note-head">
      <text class="card-title">我的笔记</text>
      <text class="note-action" bindtap="toggleNote">{{editingNote ? '取消' : (note ? '编辑' : '添加')}}</text>
    </view>
    <textarea wx:if="{{editingNote}}" class="note-input" placeholder="记录卡点、心得、易错点…" value="{{note}}" bindinput="onNoteInput" maxlength="-1" />
    <button wx:if="{{editingNote}}" class="btn-primary save-btn" bindtap="saveNote">保存笔记</button>
    <text wx:elif="{{note}}" class="note-text">{{note}}</text>
    <text wx:else class="note-placeholder">还没有笔记，点「添加」记下你的理解。</text>
  </view>
</view>
