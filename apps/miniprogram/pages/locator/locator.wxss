.reading-back { display: flex; align-items: center; box-sizing: border-box; min-height: 44px; margin-bottom: 10px; padding: 8px 12px; border-radius: 8px; background: #fff; color: #1f6feb; font-size: 13px; line-height: 1.5; }
.seg { display: flex; margin: 2px 0 10px; background: #e9edf4; border-radius: 7px; padding: 3px; }
.seg-i { flex: 1; min-width: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 44px; text-align: center; padding: 8px 6px; font-size: inherit; color: #637086; border-radius: 5px; }
.seg-i.on { background: #fff; color: #1f6feb; font-weight: 700; box-shadow: 0 1px 4px rgba(31,45,61,.08); }
.intro-title { display: block; font-size: 20px; font-weight: 700; color: #1f2d3d; }
.intro-desc { display: block; margin-top: 6px; font-size: inherit; color: #526075; line-height: 1.7; }
.grp { background: #fff; border-radius: 8px; margin-bottom: 10px; overflow: hidden; box-shadow: 0 1px 5px rgba(31,45,61,.05); }
.grp-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 10px; box-sizing: border-box; min-height: 44px; padding: 12px 14px; border-left: 4px solid #4a9bf5; }
.grp-name { flex: 1 1 130px; min-width: 0; font-size: 18px; font-weight: 700; color: #1f2d3d; }
.grp-count { font-size: 13px; color: #637086; background: #f2f5f9; padding: 2px 7px; border-radius: 10px; }
.grp-body { padding: 0 10px 10px; }
.tp-card { margin-top: 9px; border: 1px solid #e8edf4; border-radius: 7px; overflow: hidden; }
.tp-card.tp-focused { border-color: #1f6feb; box-shadow: 0 0 0 2px rgba(31,111,235,.2); }
.tp-head { box-sizing: border-box; min-height: 44px; padding: 10px 11px; }
.tp-title-row { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; }
.tp-arrow { flex-shrink: 0; width: 12px; font-size: 16px; color: #1f6feb; }
.tp-name { flex: 1 1 130px; min-width: 0; font-size: inherit; font-weight: 600; color: #1f2329; }
.tp-theme { font-size: 13px; color: #637086; }
.tp-sig-line { margin: 6px 0 0 18px; display: flex; flex-wrap: wrap; gap: 4px 5px; }
.sig-chip { max-width: 100%; font-size: 13px; color: #99560c; background: #fff6e9; padding: 2px 7px; border-radius: 9px; }
.tp-body { padding: 10px 11px 12px; border-top: 1px solid #f0f2f6; background: #fafbfd; }
.sec-label { display: block; font-size: 13px; color: #637086; margin: 9px 0 5px; }
.sec-label:first-child { margin-top: 0; }
.trap-label { color: #a33b2b; }
.kn-row { display: flex; flex-wrap: wrap; gap: 6px; }
.kn-tag { display: inline-flex; align-items: center; box-sizing: border-box; min-height: 44px; max-width: 100%; font-size: 13px; color: #1f6feb; background: #e9f1ff; padding: 8px 9px; border-radius: 10px; }
.tp-method { font-size: inherit; color: #3a7a4a; line-height: 1.7; margin-bottom: 3px; }
.tp-core { font-size: inherit; color: #3a4658; line-height: 1.75; }
.tp-step { font-size: inherit; color: #4a5568; line-height: 1.7; margin-bottom: 4px; }
.tp-trap { font-size: inherit; color: #a33b2b; line-height: 1.7; }
.searchbox { display: flex; align-items: center; box-sizing: border-box; min-height: 52px; gap: 8px; background: #fff; border-radius: 8px; padding: 4px 6px 4px 12px; margin-bottom: 12px; }
.search-input { flex: 1; min-width: 0; min-height: 44px; font-size: inherit; }
.go { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 44px; padding: 8px 14px; background: #1f6feb; color: #fff; font-size: inherit; border-radius: 6px; }
.quick-label { font-size: 13px; color: #637086; margin: 0 3px 7px; }
.quick { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 15px; }
.quick-tag { display: inline-flex; align-items: center; box-sizing: border-box; min-height: 44px; max-width: 100%; font-size: 13px; color: #1f6feb; background: #e9f1ff; padding: 8px 11px; border-radius: 12px; }
.result-head { display: flex; align-items: center; justify-content: space-between; margin: 0 3px 8px; }
.result-title { font-size: 18px; font-weight: 600; color: #1f2d3d; }
.result-sub { display: block; font-size: 13px; color: #637086; margin: 10px 3px 4px; }
.result-sub.second { margin-top: 16px; }
.clear { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 44px; min-width: 44px; padding: 8px; font-size: 13px; color: #1f6feb; }
.res { border-left: 4px solid #1f6feb; min-height: 44px; }
.res-top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 8px; }
.res-name { flex: 1 1 130px; min-width: 0; font-size: 18px; font-weight: 700; color: #1f2d3d; }
.res-score { font-size: 13px; color: #1f6feb; background: #e9f1ff; padding: 2px 7px; border-radius: 9px; }
.res-domain { display: block; margin-top: 4px; font-size: 13px; color: #637086; }
.res-ap { margin-top: 6px; font-size: inherit; color: #3a7a4a; }
.res-more { display: block; margin-top: 8px; font-size: 13px; color: #1f6feb; }
@media (min-width: 768px) {
  .intro-title { font-size: 24px; }
  .grp-head { padding: 14px 20px; }
  .grp-body { padding: 0 16px 16px; }
  .tp-head, .tp-body { padding: 12px 16px; }
}
