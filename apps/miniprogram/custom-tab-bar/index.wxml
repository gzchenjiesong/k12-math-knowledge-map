<view class="tabbar">
  <view
    class="tabbar-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="pagePath"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="switchTab"
    hover-class="tabbar-hover"
  >
    <text class="tabbar-text">{{item.text}}</text>
  </view>
</view>
