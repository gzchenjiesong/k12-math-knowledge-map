page {
  min-height: 100%;
  background: #f4f6f9;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

button {
  border-radius: 12rpx;
}

.page {
  box-sizing: border-box;
  padding: 28rpx 28rpx 60rpx;
}

.card {
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 45, 61, 0.05);
}

.muted { color: #8a94a6; }
.small { font-size: 24rpx; }
.tiny { font-size: 22rpx; }
.strong { font-weight: 600; }

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  margin: 0 12rpx 10rpx 0;
  background: #eef2f8;
  color: #4a5a70;
}

.tag-blue { background: #e7f0ff; color: #1f6feb; }
.tag-green { background: #e6f6ec; color: #1a8a4a; }
.tag-orange { background: #fff1e0; color: #b96a10; }
.tag-purple { background: #f0eaff; color: #7040b8; }

.btn-primary {
  background: #1f6feb;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.btn-ghost {
  background: #eef2f8;
  color: #33405a;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #9aa4b4;
  font-size: 28rpx;
}
