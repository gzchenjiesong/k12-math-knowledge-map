page {
  min-height: 100%;
  background: #f4f6f9;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

button { border-radius: 6px; }

/* 阅读页用物理字号；不影响 present 的固定比例画布。 */
.page {
  box-sizing: border-box;
  padding: 14px 14px 30px;
  font-size: 16px;
  line-height: 1.65;
  word-wrap: break-word;
  overflow-wrap: anywhere;
}

/* 底栏内容高度 + 安全区 + 阅读间距，仅主导航页占位。 */
.page.tab-page {
  padding-bottom: 75px;
  padding-bottom: calc(50px + env(safe-area-inset-bottom) + 25px);
}

.card {
  box-sizing: border-box;
  min-width: 0;
  background: #fff;
  border-radius: 10px;
  padding: 14px;
  margin-bottom: 12px;
  box-shadow: 0 2px 10px rgba(31, 45, 61, 0.05);
}

.muted { color: #6b7688; }
.small, .tiny { font-size: 13px; }
.strong { font-weight: 600; }

.tag {
  display: inline-block;
  box-sizing: border-box;
  max-width: 100%;
  padding: 3px 8px;
  border-radius: 12px;
  font-size: 13px;
  margin: 0 6px 6px 0;
  background: #eef2f8;
  color: #4a5a70;
}

.tag-blue { background: #e7f0ff; color: #1f6feb; }
.tag-green { background: #e6f6ec; color: #1a8a4a; }
.tag-orange { background: #fff1e0; color: #99560c; }
.tag-purple { background: #f0eaff; color: #7040b8; }

.btn-primary, .btn-ghost {
  box-sizing: border-box;
  min-height: 44px;
  padding: 10px 14px;
  font-size: 16px;
  line-height: 1.5;
  border-radius: 6px;
  white-space: normal;
  word-wrap: break-word;
  overflow-wrap: anywhere;
}
.btn-primary { background: #1f6feb; color: #fff; }
.btn-ghost { background: #eef2f8; color: #33405a; }

.empty {
  padding: 40px 10px;
  text-align: center;
  color: #6b7688;
  font-size: 16px;
}

@media (min-width: 768px) {
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px 32px 40px;
    font-size: 17px;
  }
  .page.tab-page {
    padding-bottom: 99px;
    padding-bottom: calc(66px + env(safe-area-inset-bottom) + 33px);
  }
  /* 不提高 .card 权重，保留页面里的零内边距特例。 */
  .card {
    padding: 20px 24px;
    margin-bottom: 16px;
    border-radius: 14px;
    box-shadow: 0 2px 14px rgba(31, 45, 61, 0.06);
  }
  .tag { padding: 4px 10px; margin: 0 8px 6px 0; }
  .btn-primary, .btn-ghost, .empty { font-size: 17px; }
  .empty { padding: 48px 12px; }
}
