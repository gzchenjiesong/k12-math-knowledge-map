# ============================================================
# 敏感信息 —— 绝对不可入库（服务器地址 / 凭证 / keys / token）
# ============================================================
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.p8
*.kdbx
*.secret
*secrets*
*credentials*
deploy/config/*
!deploy/config/.gitkeep
!deploy/config/*.example.json
!deploy/config/*.example.yaml
!deploy/config/*.example.yml

# ============================================================
# resource_data —— 原始资料区，本地保留，不入库
# 版权原因：教材 PDF / 教纲原文 / wiki 数据不推送到公开仓库
# 入库的只有 reliable-data/evidence/ 里的依据锚点（书名+版本+页码）
# ============================================================
resource_data/*
!resource_data/.gitkeep
!resource_data/**/.gitkeep
!resource_data/README.md

# ============================================================
# 运行配置（服务器地址 / AppID / 凭证，按实际值本地填写，不入库）
# ============================================================
apps/miniprogram/utils/runtime-config.js
deploy/server/config.json

# 微信开发者工具生成的本地私有配置（含个人编译设置，不入库）
apps/miniprogram/project.private.config.json

# ============================================================
# 生成物
# ------------------------------------------------------------
# v2.1.0 起：apps/miniprogram/data/*.js 虽为 tools/build-data.js 生成物，
# 但作为「可复现 app 数据」入库，clone 后无需本地真源即可运行小程序。
# 真源仍是 reliable-data/；这些文件禁止手工编辑，改动一律重跑生成器。
# ============================================================
apps/miniprogram/miniprogram_npm/
views/*.html
!views/.gitkeep
# bridges.json 是跨学段衔接的唯一声明（真源事实），必须入库；
# 其余 index/*.json 若为临时产物仍忽略。
reliable-data/index/*.json
!reliable-data/index/bridges.json
!reliable-data/index/.gitkeep

# ============================================================
# 小程序 / Node 运行缓存
# ============================================================
node_modules/
dist/
build/
.temp/
.cache/
*.log
!tests/evidence/*.log
.workbuddy/
.DS_Store
Thumbs.db

# ============================================================
# 本地 IDE / 系统
# ============================================================
.idea/
.vscode/*
!.vscode/settings.example.json
*.swp
*.bak
