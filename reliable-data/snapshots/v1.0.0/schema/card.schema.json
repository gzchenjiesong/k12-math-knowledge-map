{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "nodeId",
    "id",
    "title",
    "domain",
    "source_ref",
    "evidence",
    "review",
    "version",
    "content_hash"
  ],
  "properties": {
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "junior",
        "senior",
        "olympiad"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "review": {
      "type": "string",
      "enum": [
        "pending",
        "checked",
        "verified",
        "disputed"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "const": "verified"
          }
        },
        "required": [
          "review"
        ]
      },
      "then": {
        "properties": {
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reviewer",
          "date"
        ]
      }
    }
  ],
  "additionalProperties": true
}
