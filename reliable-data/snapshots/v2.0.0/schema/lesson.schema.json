{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "nodeId",
    "id",
    "title",
    "domain",
    "source_ref",
    "evidence",
    "review",
    "version",
    "content_hash",
    "essence",
    "method",
    "example",
    "pitfalls",
    "links",
    "check"
  ],
  "properties": {
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "primary",
        "junior",
        "senior",
        "olympiad"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "review": {
      "type": "string",
      "enum": [
        "pending",
        "checked",
        "verified",
        "disputed"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "essence": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "example": {
      "type": "object",
      "required": [
        "q",
        "a"
      ],
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1
        },
        "a": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pitfalls": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "string",
      "minLength": 1
    },
    "check": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review": {
            "const": "verified"
          }
        },
        "required": [
          "review"
        ]
      },
      "then": {
        "properties": {
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "reviewer",
          "date"
        ]
      }
    }
  ],
  "additionalProperties": true,
  "$id": "reliable-data/schema/lesson.schema.json",
  "title": "授课教案卡（RUL-002 六段式）"
}
